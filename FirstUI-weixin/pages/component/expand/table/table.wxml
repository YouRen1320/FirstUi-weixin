<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">Table <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">Table 表格，用于展示多条结构类似的数据。</view>
		</view>
		<view class="fui-page__bd">
			<view class="fui-section__title">基础使用</view>
			<fui-table itemList="{{tableData}}" header="{{headerData}}"></fui-table>
			<view class="fui-section__title">横向铺满/斑马纹</view>
			<fui-table full stripe itemList="{{tableData}}" header="{{headerData}}"></fui-table>
			<view class="fui-section__title">行列固定/排序</view>
			<fui-table id="sortTable" fixed height="600" itemList="{{itemList}}" header="{{header}}" bindclick="detail" bind:sortChange="sortChange"></fui-table>
      <view class="fui-section__title">多选/禁用选择/默认选中</view>
			<!--如果需要初始化时触发 bind:selectionChange 事件，将属性 initEmitChange 设为true-->
			<fui-table id="table" selection full itemList="{{tableData}}" header="{{headerData}}"	bindselectionChange="change"></fui-table>

			<view class="fui-flex__center fui-flex__column">
				<fui-button type="gray" btn-size="medium" text="切换第三行选中状态" bold margin="48rpx 0 24rpx" bindclick="toggleSelection"></fui-button>
        <fui-button type="gray" btn-size="medium" text="取消所有选择" bold bindclick="clearSelection"></fui-button>
			</view>
		</view>
	</view>
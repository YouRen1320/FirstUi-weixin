<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Validator<image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Validator 表单验证，提供了常用的表单校验方法（完整内容请查看文档），支持传入自定义校验方法。</view>
  </view>
  <view class="fui-page__bd">
    <fui-input required label="姓名" borderTop placeholder="请输入姓名" model:value="{{name}}"></fui-input>
    <fui-input required label="手机号" placeholder="请输入手机号码" model:value="{{mobile}}"></fui-input>
    <fui-input required label="密码" password placeholder="请输入密码" model:value="{{password}}">
    </fui-input>
    <fui-input required label="确认密码" password placeholder="请再次输入密码" model:value="{{confirmPwd}}">
    </fui-input>
    <fui-input label="年龄" placeholder="请输入年龄" model:value="{{age}}"></fui-input>
    <fui-input label="身份证" placeholder="请输入身份证号码" model:value="{{idCard}}"></fui-input>
    <fui-input label="邮箱" placeholder="请输入邮箱" model:value="{{email}}"></fui-input>
    <fui-input label="个人主页" placeholder="请输入个人主页" model:value="{{url}}">
    </fui-input>
    <fui-input label="商品金额" placeholder="请输入商品金额" model:value="{{amount}}">
    </fui-input>
    <fui-input label="微信号" bottomLeft="{{0}}" placeholder="自定义校验，6至20位，字母，数字..." model:value="{{wechatNo}}">
    </fui-input>
    <view class="fui-btn__box">
      <fui-button text="Submit" bold bindclick="submit"></fui-button>
    </view>
  </view>
</view>
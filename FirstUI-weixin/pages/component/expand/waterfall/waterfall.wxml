<view class="fui-wrap">
		<view class="fui-page__hd">
			<view  class="fui-page__title fui-align__center" bindtap="vip">Waterfall <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view bind:tap="onInsert" class="fui-page__desc">Waterfall 瀑布流，是比较流行的一种页面布局，视觉表现为参差不齐的多栏布局。</view>
		</view>
		<view class="fui-page__bd">
			<fui-waterfall isBefore bindend="onEnd">
				<fui-waterfall-item wx:for="{{images}}" wx:key="index" src="{{item}}">
					<view class="fui-text">自定义信息</view>
				</fui-waterfall-item>
			</fui-waterfall>
			<fui-loadmore wx:if="{{!isEnd}}"></fui-loadmore>
		</view>
	</view>
<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Timer <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Timer 计时器，可累加计时。</view>
  </view>
  <view class="fui-page__bd">
    <view class="fui-section__title">20s自动结束</view>
    <view class="fui-timer__box">
      <fui-timer maxTime="{{20}}" bindend="end"></fui-timer>
    </view>
    <view class="fui-section__title">冒号显示为文字</view>
    <view class="fui-timer__box">
      <fui-timer isColon="{{false}}" maxTime="{{40}}" bindend="end"></fui-timer>
    </view>
    <view class="fui-section__title">更换样式，显示毫秒</view>
    <view class="fui-timer__box">
      <fui-timer background="#465CFF" color="#fff" colonColor="#465CFF" isMs msWidth="40" maxTime="{{180}}" bindend="end"></fui-timer>
    </view>
    <view class="fui-section__title">手动控制</view>
    <view class="fui-timer__box">
      <fui-timer id="timer" isMs autoStart="{{false}}" bindend="end"></fui-timer>
    </view>
    <fui-grid bindclick="handleClick">
      <fui-grid-item backgroundColor="#fff">
        <view class="fui-grid__cell">
          <fui-icon name="play"></fui-icon>
          <text>开始</text>
        </view>
      </fui-grid-item>
      <fui-grid-item backgroundColor="#fff" index="{{1}}">
        <view class="fui-grid__cell">
          <fui-icon name="suspend"></fui-icon>
          <text>暂停</text>
        </view>
      </fui-grid-item>
      <fui-grid-item backgroundColor="#fff" index="{{2}}">
        <view class="fui-grid__cell">
          <fui-icon name="refresh"></fui-icon>
          <text>重置</text>
        </view>
      </fui-grid-item>
    </fui-grid>
  </view>
</view>
<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">Circle <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">Circle 圆形进度条，用于展现某个任务的当前进度。</view>
		</view>
		<view class="fui-page__bd fui-page__spacing">
			<view class="fui-section__title">基础使用</view>
			<fui-circle percent="{{80}}"></fui-circle>
			<view class="fui-section__title">调整样式/起始弧度/渐变</view>
			<fui-circle percent="{{75}}" color="#FFB703" background="#EEEEEE" foreground="#FFB703" foreground="#FFB703" gradient="#FAE845"
				sAngle="{{-0.5}}" width="{{200}}"	strokeWidth="{{6}}" size="{{16}}"></fui-circle>
			<view class="fui-section__title">调整百分比</view>
			<fui-circle percent="{{percent}}"></fui-circle>
			<view class="fui-btn__box">
				<fui-button type="gray" width="400rpx" height="84rpx" text="percent" bold margin="24rpx"
					bindclick="percentChange"></fui-button>
			</view>
		</view>
	</view>
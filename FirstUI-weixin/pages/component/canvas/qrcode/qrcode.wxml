<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Qrcode <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Qrcode 二维码，主要用于存储网址、名片、文本信息、特定代码等信息。</view>
  </view>
  <view class="fui-page__bd">
    <view class="fui-textarea__box">
      <fui-textarea model:value="{{val}}"></fui-textarea>
    </view>
    <fui-button type="gray" width="400rpx" height="84rpx" text="生成" bold margin="32rpx 0 64rpx" bindclick="qrcode">
    </fui-button>
    <fui-qrcode value="{{value}}"></fui-qrcode>
  </view>
</view>
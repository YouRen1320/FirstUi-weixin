<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Fab <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Fab 浮动按钮，主要特点是轻盈、便捷、高效，用于在屏幕上执行主要或最常见的操作。</view>
  </view>
  <view class="fui-page__bd">
    <fui-button type="gray" width="400rpx" height="84rpx" text="基础使用" bold margin="24rpx 0" bindclick="fab" data-type="1">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="更换背景色" bold bindclick="fab" data-type="2">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="图标换为文本" bold margin="24rpx 0" bindclick="fab" data-type="3">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="切换位置" bold bindclick="fab" data-type="4">
    </fui-button>
  </view>
  <fui-fab background="{{background}}" position="{{isLeft?'left':'right'}}" fabs="{{fabs}}" bindclick="handleClick" isDrag></fui-fab>

  <fui-fab zIndex="{{10}}" position="{{isLeft?'right':'left'}}" bindclick="fabClick" custom>
    <fui-icon name="edit-fill" color="#fff"></fui-icon>
  </fui-fab>
</view>
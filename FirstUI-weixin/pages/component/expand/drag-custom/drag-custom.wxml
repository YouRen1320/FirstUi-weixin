<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">Drag <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">Drag 拖拽排序，通过拖动列表元素以此来达到对数据的重新排列。长按列表开启拖拽。</view>
		</view>
		<view class="fui-page__bd">
			<fui-drag generic:item="f-drag-item" width="{{680}}" custom itemList="{{itemList}}" columns="{{4}}" itemHeight="{{200}}" bindend="end"></fui-drag>
		</view>
	</view>
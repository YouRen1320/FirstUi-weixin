<view class="fui-wrap fui-page__bd">
  <fui-list-cell bottom-right="32" arrow wx:for="{{logs}}" wx:key="index" bindclick="detail" data-date="{{item.date}}"
    data-version="{{item.version}}">
    <view>
      <view class="fui-title">First UI {{item.version}} 主要更新</view>
      <view class="fui-date">{{item.date}}</view>
    </view>
  </fui-list-cell>
</view>
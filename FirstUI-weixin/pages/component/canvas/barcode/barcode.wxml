<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Barcode <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Barcode 条形码，用于展现条形码信息。</view>
  </view>
  <view class="fui-page__bd">
    <view class="fui-input__box">
      <fui-input model:value="{{val}}" maxlength="13" type="number"></fui-input>
      <view class="fui-tips">请输入13位条码信息，扫描只能识别有效的条形码（EAN-13）。</view>
    </view>
    <fui-button type="gray" width="400rpx" height="84rpx" text="生成" bold margin="32rpx 0 64rpx" bindclick="barcode">
    </fui-button>
    <fui-barcode id="barcode" value="{{val}}"></fui-barcode>
    <view class="fui-input__box fui-mt--96">
      <fui-input model:value="{{code128}}" placeholder="请输入条码"></fui-input>
      <view class="fui-tips">请输入条码信息，不支持中文（类型：Code 128）。</view>
    </view>
    <fui-button type="gray" btn-size="medium" text="生成" bold margin="32rpx 0 64rpx" bindclick="barcodeCode128">
    </fui-button>
    <fui-barcode type="2" id="barcode_code" value="{{code128}}"></fui-barcode>
  </view>
</view>
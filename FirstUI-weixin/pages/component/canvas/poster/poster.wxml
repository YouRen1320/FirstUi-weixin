<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Poster <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Poster 分享海报 ，传入JSON数据生成海报。</view>
  </view>
  <view class="fui-page__bd">
    <fui-button type="gray" width="400rpx" height="84rpx" text="基本使用" bold margin="24rpx 0" bindclick="poster" data-type="1">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="生成商品海报" bold bindclick="poster" data-type="2"></fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="First UI分享海报" bold margin="24rpx 0" bindclick="share"></fui-button>
  </view>
  <fui-poster id="generator" width="{{560}}" height="{{980}}" bindready="ready"></fui-poster>
</view>
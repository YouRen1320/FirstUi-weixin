<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">SlideVerify <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">SlideVerify 滑动验证码，根据提示进行行为验证。</view>
		</view>
		<view class="fui-page__bd fui-page__spacing">
			<view class="fui-section__title">基础使用</view>
			<fui-slide-verify bindsuccess="success" bindfail="fail"></fui-slide-verify>
			<view class="fui-section__title">调整样式</view>
			<fui-slide-verify background="rgba(9, 190, 79, .05)" activeBgColor="#09BE4F" passColor="#09BE4F"
				lineColor="#FFB703" bindsuccess="success" bindfail="fail"></fui-slide-verify>
			<view class="fui-section__title">重置验证</view>
			<fui-slide-verify id="sv" bindsuccess="success" bindfail="fail"></fui-slide-verify>
			<view class="fui-btn__box">
        <fui-button type="gray" width="400rpx" height="84rpx" text="重置验证" bold margin="40rpx"
					bindclick="reset">
				</fui-button>
			</view>
		</view>
	</view>
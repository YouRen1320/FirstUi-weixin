<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">TimeAxis <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">TimeAxis 时间轴，用于展现时间流信息。</view>
  </view>
  <view class="fui-page__bd">
    <view class="fui-section__title">右侧展示</view>
    <fui-timeaxis background="#fff" padding="32rpx 16rpx">
      <fui-timeaxis-node lineColor="{{index<3?item.activeColor:'#ccc'}}" lined="{{index!==processData.length-1}}" wx:for="{{processData}}" wx:key="index">
        <view class="fui-node" style="border-color:{{item.activeColor}}">
        </view>
        <view slot="right" class="fui-process__node {{index!==processData.length-1?'fui-node__pb':''}}">
          <view class="fui-title" style="color:{{index===3?item.activeColor:'#181818'}}">{{item.title}}
          </view>
          <view class="fui-descr" wx:if="{{item.descr}}">{{item.descr}}</view>
          <view class="fui-time">{{item.time}}</view>
        </view>
      </fui-timeaxis-node>
    </fui-timeaxis>
    <view class="fui-section__title">左右展示</view>
    <fui-timeaxis leftWidth="200" background="#fff" padding="32rpx 16rpx">
      <fui-timeaxis-node lineColor="{{index<3?item.activeColor:'#ccc'}}" lined="{{index!==processData.length-1}}" wx:for="{{processData}}" wx:key="index">
        <view class="fui-node" style="border-color:{{item.activeColor}}">
        </view>
        <view slot="left" class="fui-time__left">{{item.time}}</view>
        <view slot="right" class="fui-process__node {{index!==processData.length-1?'fui-node__pbtm':''}}">
          <view class="fui-title" style="color:{{index===3?item.activeColor:'#181818'}}">{{item.title}}
          </view>
          <view class="fui-descr" wx:if="{{item.descr}}">{{item.descr}}</view>
        </view>
      </fui-timeaxis-node>
    </fui-timeaxis>
    <view class="fui-section__title">节点设置icon</view>
    <fui-timeaxis background="#fff" padding="32rpx 16rpx">
      <fui-timeaxis-node>
        <view class="fui-node__box" style="background: #FF2B2B;">
          <fui-icon name="check" size="{{28}}" color="#fff"></fui-icon>
        </view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder">自定义内容</view>
        </view>
      </fui-timeaxis-node>
      <fui-timeaxis-node>
        <view class="fui-node__box" style="background: #09BE4F;">
          <fui-icon name="face" size="{{28}}" color="#fff"></fui-icon>
        </view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder">自定义内容</view>
        </view>
      </fui-timeaxis-node>
      <fui-timeaxis-node>
        <view class="fui-node__box" style="background: #465CFF;">
          <fui-icon name="my-fill" size="{{28}}" color="#fff"></fui-icon>
        </view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder">自定义内容</view>
        </view>
      </fui-timeaxis-node>
      <fui-timeaxis-node>
        <view class="fui-node__sm"></view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder">自定义内容</view>
        </view>
      </fui-timeaxis-node>
      <fui-timeaxis-node>
        <view class="fui-node"></view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder" style="height: 400rpx;">First UI</view>
        </view>
      </fui-timeaxis-node>
      <fui-timeaxis-node lined="{{false}}">
        <view class="fui-node"></view>
        <view slot="right" class="fui-custom__wrap">
          <view class="fui-custom__innder">
            <image src="/static/images/common/logo.png" class="fui-logo"></image>
          </view>
        </view>
      </fui-timeaxis-node>
    </fui-timeaxis>
  </view>
</view>
<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Message <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Message 消息提示，用于展现简短的提示信息，在窗口顶部显示。</view>
  </view>
  <view class="fui-page__bd">
    <fui-button type="gray" width="400rpx" height="84rpx" text="基础使用" bold margin="24rpx 0" bindclick="showMsg" data-type="1"></fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="自定义背景色" bold bindclick="showMsg" data-type="2">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="带图标提示" bold margin="24rpx 0" bindclick="showMsg" data-type="3">
    </fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="设置显示时间" bold bindclick="showMsg" data-type="4">
    </fui-button>
  </view>
  <fui-message id="msg" background="{{background}}"></fui-message>
  <fui-message id="tips">
    <view class="fui-icon__box">
      <fui-icon name="checkbox" color="#fff" size="{{48}}"></fui-icon>
    </view>
  </fui-message>
</view>
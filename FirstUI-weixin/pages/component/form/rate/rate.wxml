<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">Rate <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">Rate 评分，对评价进行展示或对事物进行快速的评级操作。</view>
		</view>
		<view class="fui-page__bd fui-page__spacing">
			<view class="fui-section__title">基础使用</view>
			<fui-rate bindchange="change"></fui-rate>
			<view class="fui-section__title">设置颜色</view>
			<fui-rate color="#888" activeColor="#465CFF" bindchange="change"></fui-rate>
			<view class="fui-section__title">设置大小</view>
			<fui-rate size="{{48}}" bindchange="change"></fui-rate>
			<view class="fui-section__title">设置最大评分数</view>
			<fui-rate max="{{8}}" score="{{5}}" bindchange="change"></fui-rate>
			<view class="fui-section__title">支持半星</view>
			<fui-rate allowHalf bindchange="change"></fui-rate>
			<view class="fui-section__title">仅展示，禁用操作</view>
			<fui-rate disabled score="{{3}}" bindchange="change"></fui-rate>
		</view>
	</view>
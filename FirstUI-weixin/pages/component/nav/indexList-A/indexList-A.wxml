<!--该组件支持抽象节点，使用 generic:item="组件名称" 可替换掉默认节点内容-->
<!--关于抽象节点文档：https://developers.weixin.qq.com/miniprogram/dev/framework/custom-component/generics.html-->

<fui-index-list isSrc listData="{{lists}}" bindinit="init" bindclick="itemClick">
		<fui-search-bar bindsearch="search"></fui-search-bar>
		<view slot="footer">
			<fui-loadmore wx:if="{{!show}}"></fui-loadmore>
			<fui-divider text="66个朋友及联系人" wx:if="{{show}}"></fui-divider>
		</view>
	</fui-index-list>
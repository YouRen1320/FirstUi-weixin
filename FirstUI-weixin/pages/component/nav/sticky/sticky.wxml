    <fui-button type="gray" width="400rpx" height="84rpx" text="基础使用" bold margin="24rpx 0" bindclick="sticky" data-type="1"></fui-button>
    <fui-button type="gray" width="400rpx" height="84rpx" text="指定内容范围" bold bindclick="sticky" data-type="2">
    </fui-button>

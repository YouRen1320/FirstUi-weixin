<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">RotateVerify <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">RotateVerify 旋转验证码，根据提示进行行为验证。</view>
		</view>
		<view class="fui-page__bd">
			<view class="fui-btn__box">
				<fui-button type="gray" width="400rpx" height="84rpx" text="点击按钮进行验证" bold margin="48rpx"
					bindclick="btnVerify">
				</fui-button>
			</view>
			<fui-rotate-verify id="rv" src="{{src}}" bindverify="verify"></fui-rotate-verify>
		</view>
	</view>
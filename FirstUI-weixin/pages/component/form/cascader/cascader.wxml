<view class="fui-wrap">
  <view class="fui-page__hd">
    <view class="fui-page__title fui-align__center" bindtap="vip">Cascader <image src="/static/images/index/light/icon_member_3x.png"></image>
    </view>
    <view class="fui-page__desc">Cascader 级联选择器，用于一组相关联的数据集合进行选择，例如省市区等。</view>
  </view>
  <view class="fui-page__bd">
    <view class="fui-section__title">基础使用</view>
    <fui-cascader bindcomplete="complete" options="{{options}}"></fui-cascader>
    <view class="fui-section__title">默认选项</view>
    <fui-cascader id="cascader" bindcomplete="complete" options="{{options}}" value="{{value}}" activeColor="#FF2B2B">
    </fui-cascader>
    <view class="fui-flex__center">
      <fui-button type="gray" width="400rpx" height="84rpx" text="重置选择" bold margin="48rpx 0 0" bindclick="btnReset"></fui-button>
    </view>
    <view class="fui-section__title">逐级请求数据</view>
    <fui-cascader id="cascader1" options="{{layer1}}" stepLoading bindchange="change" bindcomplete="complete">
    </fui-cascader>
    <view class="fui-section__title">逐级请求数据/默认选项</view>
    <fui-cascader id="cascader2" options="{{layerData}}" value="{{value2}}" stepLoading bindchange="change2" bindcomplete="complete">
    </fui-cascader>
    <view class="fui-flex__center">
      <fui-button type="gray" width="400rpx" height="84rpx" text="底部弹出选择" bold margin="48rpx 0 0" bindclick="btnSelect"></fui-button>
    </view>
  </view>
  <fui-bottom-popup show="{{show}}">
    <view class="fui-scroll__wrap">
      <view class="fui-title">请选择地区</view>
      <fui-cascader bindcomplete="complete2" options="{{options}}"></fui-cascader>
      <view class="fui-icon__close" catchtap="closePopup">
        <fui-icon name="close" size="{{48}}"></fui-icon>
      </view>
    </view>
  </fui-bottom-popup>
</view>
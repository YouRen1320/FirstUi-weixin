<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-page__title fui-align__center" bindtap="vip">SliderCaptcha <image
					src="/static/images/index/light/icon_member_3x.png"></image>
			</view>
			<view class="fui-page__desc">SliderCaptcha 滑块拼图验证，根据提示进行行为验证。</view>
		</view>
		<view class="fui-page__bd">
			<view class="fui-btn__box">
				<fui-button type="gray" width="400rpx" height="84rpx" text="点击按钮进行验证" bold margin="48rpx"
					bindclick="btnVerify">
				</fui-button>
			</view>
			<!--务必保证属性 imageType 正确，注意处理图片资源问题-->
			<fui-slider-captcha id="scRef" src="{{src}}" bindsuccess="success" bindfail="fail">
			</fui-slider-captcha>
		</view>
	</view>
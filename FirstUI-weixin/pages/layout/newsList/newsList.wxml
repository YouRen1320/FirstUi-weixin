<view class="fui-wrap">
		<view class="fui-page__hd">
			<view class="fui-align__center" bindtap="vip">
				<text class="fui-page__title">NewsList</text>
				<image src="/static/images/index/light/icon_member_3x.png" class="fui-vip__icon"></image>
			</view>
			<text class="fui-page__desc">新闻列表，常用的页面布局，可提升开发效率以及带来舒服的视觉效果！</text>
		</view>
		<view class="fui-page__bd">
			<view class="fui-section__title">标题列表</view>
			<view class="fui-news__list">
				<view class="fui-news__item" wx:for="{{newsList}}" wx:key="index">
					<fui-overflow-hidden text="{{item.title || ''}}" size="36" rows="{{1}}"></fui-overflow-hidden>
					<view class="fui-news__info">
						<fui-text wx:if="{{item.isTop}}" padding="0 20rpx 0 0" text="置顶" size="25"
							color="#FF2B2B"></fui-text>
						<fui-text padding="0 20rpx 0 0" text="{{item.source || ''}}" size="25" color="#7F7F7F">
						</fui-text>
						<fui-text text="{{item.comment}}评论" size="25" color="#7F7F7F"></fui-text>
					</view>
				</view>
			</view>

			<view class="fui-section__title">带图片列表</view>
			<view class="fui-news__list">
				<fui-list topBorder="{{false}}" bottomBorder bottomLeft="32" bottomRight="32"	wx:for="{{newsList}}" wx:key="index">
					<view class="fui-news__item">
						<fui-overflow-hidden text="{{item.title}}" size="36" rows="3"></fui-overflow-hidden>
						<view class="fui-image__list" wx:if="{{item.imageList && item.imageList.length}}">
							<fui-lazyload src="{{src}}" wx:for-item="src" wx:for-index="idx" wx:for="{{item.imageList}}" wx:key="idx"	width="{{item.imageList.length>1?200:400}}" height="{{item.imageList.length>1?200:0}}" marginRight="20" mode="aspectFill"></fui-lazyload>
						</view>
						<view class="fui-news__info">
							<fui-text wx:if="{{item.isTop}}" padding="0 20rpx 0 0" text="置顶" size="25" 	color="#FF2B2B"></fui-text>
							<fui-text padding="0 20rpx 0 0" text="{{item.source}}" size="25" color="#7F7F7F">
							</fui-text>
							<fui-text text="{{item.comment}}评论" size="25" color="#7F7F7F"></fui-text>
						</view>
					</view>
				</fui-list>
			</view>
		</view>
	</view>